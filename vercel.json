{
  "rewrites": [
    {
      "source": "/user-api/:path*",
      "destination": "https://aroma-user.onrender.com/:path*"
    },
    {
      "source": "/restaurant-api/:path*",
      "destination": "https://aroma-restaurant.onrender.com/:path*"
    },
    {
      "source": "/order-api/:path*",
      "destination": "https://aroma-order.onrender.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
